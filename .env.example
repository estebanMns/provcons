# Copia este archivo como .env y completa los valores. Nunca subas .env a git.

APP_NAME="ProvCons - Backend"
# development publica /docs; production lo apaga
ENVIRONMENT=development

# PostgreSQL con el driver asyncpg (debe empezar con postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASEÑA@HOST:5432/NOMBRE_BD

# Firma de los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini (lectura de archivos y revisión con IA del inventario)
GEMINI_API_KEY=
# false = el matching compara solo por texto, sin llamar a la IA
MATCHING_AI_REVIEW=true
# Tiempo límite por intento de cada llamada a Gemini (segundos)
AI_TIMEOUT_SECONDS=90

# Motor de comparación: grpc = microservicio (python -m app.grpc_engine.server,
# con respaldo local si no responde); local = en el mismo proceso de la API
MATCHING_ENGINE_MODE=grpc
MATCHING_ENGINE_ADDR=127.0.0.1:50051
MATCHING_ENGINE_TIMEOUT=10

# Orígenes del frontend permitidos, como lista JSON (en local no hace falta)
# CORS_ORIGINS=["https://tu-app.vercel.app"]
